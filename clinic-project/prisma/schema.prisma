// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique
  password  String
  role      String   @default("patient")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  appointments Appointment[]
  chatMessages  ChatMessage[]
  comments      Comment[]

  @@map("users")
}

model Appointment {
  id          Int      @id @default(autoincrement())
  patientName String   @map("patient_name")
  patientPhone String  @map("patient_phone")
  day         String
  date        DateTime
  time        String
  description String?
  status      String   @default("pending")
  userId      Int?     @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  smsSent     Boolean  @default(false) @map("sms_sent")

  user        User?    @relation(fields: [userId], references: [id])

  @@unique([date, time]) // جلوگیری از نوبت‌های همزمان
  @@map("appointments")
}

model ChatMessage {
  id          Int      @id @default(autoincrement())
  sessionId   String   @map("session_id")
  userId      Int?     @map("user_id")
  userMsg     String   @map("user_message")
  botMsg      String   @map("bot_message")
  adminReply  String?  @map("admin_reply")
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id])

  @@map("chat_messages")
}

//  مدل مقاله
model Article {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  summary     String
  content     String
  image       String?
  pdfUrl      String?  // ← اضافه شد
  category    String
  tags        String?
  author      String   @default("فرشته صادقی")
  views       Int      @default(0)
  publishedAt DateTime @default(now()) @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  comments    Comment[]

  @@map("articles")
}

//  مدل نظر
model Comment {
  id          Int      @id @default(autoincrement())
  content     String
  author      String
  email       String?
  articleId   Int      @map("article_id")
  userId      Int?     @map("user_id")
  isApproved  Boolean  @default(false) @map("is_approved")
  adminReply  String?  @map("admin_reply") // ← جدید
  createdAt   DateTime @default(now()) @map("created_at")

  article     Article  @relation(fields: [articleId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  @@map("comments")
}